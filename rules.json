{
  "version": 104,
  "platforms": [
    {
      "id": "facebook",
      "name": "Facebook",
      "domains": ["facebook.com", "fb.watch", "m.facebook.com", "fb.gg"],
      "match_regex": "https?:\\/\\/(?:www\\.|m\\.|web\\.)?facebook\\.com\\/[^\"'\\s]+",
      "videoUrlRegex": "https?:\\/\\/(?:www\\.|m\\.|web\\.)?facebook\\.com\\/[^\"'\\s]+",
      "extractRules": {
        "titleSelectors": ["meta[property='og:title']", "title"],
        "thumbnailSelectors": ["meta[property='og:image']"],
        "videoStreamRegexes": [
          "\"browser_native_hd_url\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "\"browser_native_sd_url\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "\"playable_url_quality_hd\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "\"playable_url\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "hd_src\\s*:\\s*\"([^\"]+)\"",
          "sd_src\\s*:\\s*\"([^\"]+)\""
        ]
      }
    },
    {
      "id": "instagram",
      "name": "Instagram",
      "domains": ["instagram.com", "instagr.am"],
      "match_regex": "https?:\\/\\/(?:www\\.)?instagram\\.com\\/(?:p|reel|reels|tv)\\/[^\"'\\s]+",
      "videoUrlRegex": "https?:\\/\\/(?:www\\.)?instagram\\.com\\/(?:p|reel|reels|tv)\\/[^\"'\\s]+",
      "extractRules": {
        "graphqlTemplate": "https://www.instagram.com/graphql/query/?doc_id=10015901848480474&variables=%7B%22shortcode%22%3A%22{shortcode}%22%7D",
        "embedTemplate": "https://www.instagram.com/p/{shortcode}/embed/captioned/",
        "titleSelectors": ["meta[property='og:title']", "title"],
        "thumbnailSelectors": ["meta[property='og:image']", "img.EmbeddedMediaImage"],
        "videoStreamRegexes": [
          "(https?:\\\\?/\\\\?/[^\",'\\s\\}\\]]+\\.mp4[^\",'\\s\\}\\]]*)",
          "\"video_url\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "src=\"(https?:\\\\/\\\\/[^\"]+\\.mp4[^\"]*)\""
        ]
      }
    },
    {
      "id": "tiktok",
      "name": "TikTok",
      "domains": ["tiktok.com", "vm.tiktok.com", "vt.tiktok.com"],
      "match_regex": "https?:\\/\\/(?:www\\.|vt\\.|vm\\.)?tiktok\\.com\\/[^\"'\\s]+",
      "videoUrlRegex": "https?:\\/\\/(?:www\\.|vt\\.|vm\\.)?tiktok\\.com\\/[^\"'\\s]+",
      "extractRules": {
        "titleSelectors": ["meta[property='og:title']", "title"],
        "thumbnailSelectors": ["meta[property='og:image']"],
        "videoStreamRegexes": [
          "\"playAddr\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "\"downloadAddr\":\"(https?:\\\\/\\\\/[^\"]+)\"",
          "meta\\[property='og:video'\\]"
        ]
      }
    },
    {
      "id": "twitter",
      "name": "Twitter / X",
      "domains": ["twitter.com", "x.com"],
      "match_regex": "https?:\\/\\/(?:www\\.)?(?:twitter|x)\\.com\\/(?:i\\/|[^\"'\\s]+\\/)?status\\/\\d+",
      "videoUrlRegex": "https?:\\/\\/(?:www\\.)?(?:twitter|x)\\.com\\/(?:i\\/|[^\"'\\s]+\\/)?status\\/\\d+",
      "extractRules": {
        "vxtwitterTemplate": "https://api.vxtwitter.com/Twitter/status/{tweet_id}",
        "fxtwitterTemplate": "https://api.fxtwitter.com/status/{tweet_id}",
        "syndicationTemplate": "https://cdn.syndication.twimg.com/tweet-result?id={tweet_id}&token=x",
        "titleSelectors": ["meta[property='og:title']", "title"],
        "thumbnailSelectors": ["meta[property='og:image']"],
        "videoStreamRegexes": [
          "(https?:\\\\?/\\\\?/[^\",'\\s\\}\\]]+\\.mp4[^\",'\\s\\}\\]]*)",
          "\"url\":\"(https?:\\\\/\\\\/video\\.twimg\\.com\\\\[^\"]+\\.mp4[^\"]*)\""
        ]
      }
    },
    {
      "id": "pinterest",
      "name": "Pinterest",
      "domains": ["pinterest.com", "pin.it"],
      "match_regex": "https?:\\/\\/(?:[a-z]{2}\\.)?pinterest\\.com\\/pin\\/\\d+",
      "videoUrlRegex": "https?:\\/\\/(?:[a-z]{2}\\.)?pinterest\\.com\\/pin\\/\\d+",
      "extractRules": {
        "titleSelectors": ["meta[property='og:title']", "title"],
        "thumbnailSelectors": ["meta[property='og:image']"],
        "videoStreamRegexes": [
          "\"url\":\"(https?:\\\\/\\\\/v1\\.pinimg\\.com\\\\[^\"]+\\.mp4[^\"]*)\"",
          "meta\\[property='og:video'\\]"
        ]
      }
    }
  ]
}
